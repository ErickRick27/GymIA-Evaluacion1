<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Barra superior con título y botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/txtTituloLista"
            style="@style/EstiloTituloPantalla"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_lista" />

        <Button
            android:id="@+id/btnAbrirIA"
            style="@style/EstiloBotonSecundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_abrir_ia" />

        <Button
            android:id="@+id/btnNuevaRutina"
            style="@style/EstiloBotonPrimario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_nueva_rutina" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtSubtituloHistorial"
        style="@style/EstiloSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/subtitulo_historial" />

    <!-- ScrollView con al menos 3 filas de ejemplo -->
    <ScrollView
        android:id="@+id/svListaRutinas"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Fila 1 -->
            <LinearLayout
                android:id="@+id/cardRutina1"
                style="@style/EstiloTarjetaGym"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFila1Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fila1_titulo"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFila1Detalle"
                    style="@style/EstiloSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/fila1_detalle" />

                <TextView
                    android:id="@+id/txtFila1Estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/fila1_estado"
                    android:textColor="@color/primario"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila 2 -->
            <LinearLayout
                android:id="@+id/cardRutina2"
                style="@style/EstiloTarjetaGym"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFila2Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fila2_titulo"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFila2Detalle"
                    style="@style/EstiloSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/fila2_detalle" />

                <TextView
                    android:id="@+id/txtFila2Estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/fila2_estado"
                    android:textColor="@color/primario"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila 3 -->
            <LinearLayout
                android:id="@+id/cardRutina3"
                style="@style/EstiloTarjetaGym"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtFila3Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fila3_titulo"
                    android:textColor="@color/texto_principal"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFila3Detalle"
                    style="@style/EstiloSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/fila3_detalle" />

                <TextView
                    android:id="@+id/txtFila3Estado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/fila3_estado"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
