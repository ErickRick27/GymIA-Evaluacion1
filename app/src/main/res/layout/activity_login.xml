<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgLogoGymIA"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/desc_logo_gymia"
            android:src="@drawable/ic_logo_gymia" />

        <TextView
            android:id="@+id/txtNombreApp"
            style="@style/EstiloTituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/primario"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/txtSubtituloLogin"
            style="@style/EstiloSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:gravity="center"
            android:text="@string/subtitulo_login" />

        <EditText
            android:id="@+id/edtCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_correo"
            android:inputType="textEmailAddress"
            android:minHeight="48dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/edtContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:autofillHints="password"
            android:hint="@string/hint_contrasena"
            android:inputType="textPassword"
            android:minHeight="48dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <Button
            android:id="@+id/btnIngresar"
            style="@style/EstiloBotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/btn_ingresar" />

        <Button
            android:id="@+id/btnIrRegistro"
            style="@style/EstiloBotonSecundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_ir_registro" />

    </LinearLayout>
</ScrollView>
