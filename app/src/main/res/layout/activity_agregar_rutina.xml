<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloAgregar"
            style="@style/EstiloTituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_agregar" />

        <TextView
            android:id="@+id/txtSubtituloAgregar"
            style="@style/EstiloSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/subtitulo_agregar" />

        <EditText
            android:id="@+id/edtGrupoMuscular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_grupo_muscular"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:minHeight="48dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <EditText
            android:id="@+id/edtNombreEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="@string/hint_nombre_ejercicio"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:minHeight="48dp"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtSeries"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/hint_series"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minHeight="48dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario" />

            <EditText
                android:id="@+id/edtRepeticiones"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:hint="@string/hint_repeticiones"
                android:importantForAutofill="no"
                android:inputType="number"
                android:minHeight="48dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario" />

            <EditText
                android:id="@+id/edtPesoKg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/hint_peso_kg"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:minHeight="48dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtNotasEjercicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="top|start"
            android:hint="@string/hint_notas_ejercicio"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <Button
            android:id="@+id/btnGuardarRutina"
            style="@style/EstiloBotonPrimario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_guardar_rutina" />

    </LinearLayout>
</ScrollView>
